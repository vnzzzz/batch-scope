{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatchScope Node",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "name"],
  "properties": {
    "type": {
      "enum": ["management_unit", "job_network", "job", "file", "file_pattern", "job_status", "external_event"]
    },
    "id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "name": {"type": "string", "minLength": 1, "maxLength": 2048},
    "path": {"type": "string", "maxLength": 8192},
    "parentId": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
    "limitFacts": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "limit-fact.schema.json"}
    },
    "locator": {"type": "object", "additionalProperties": true},
    "attributes": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"enum": ["file", "file_pattern", "job_status", "external_event"]}}},
      "then": {
        "properties": {
          "parentId": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"enum": ["management_unit", "job_network", "file", "file_pattern", "job_status", "external_event"]}}},
      "then": {"properties": {"limitFacts": {"maxItems": 0}}}
    }
  ]
}
