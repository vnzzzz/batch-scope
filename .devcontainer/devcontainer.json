{
  "name": "BatchScope",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26.5"
    },
    "ghcr.io/vnzzzz/agentic-development-toolkit/agent-dev:1": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "BATCHSCOPE_DATA_DIR": "/tmp/batchscope"
  },
  "mounts": [
    "source=batchscope-go-mod-${devcontainerId},target=/go/pkg/mod,type=volume",
    "source=batchscope-go-build-${devcontainerId},target=/home/vscode/.cache/go-build,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "go.testFlags": [
          "-race"
        ],
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "BatchScope API",
      "onAutoForward": "notify"
    }
  }
}
